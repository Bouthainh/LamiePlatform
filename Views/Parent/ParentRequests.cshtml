@model List<LamiePlatform.Models.Request>
@{
    ViewData["Title"] = "لامع - طلبات المعلمين";
    ViewData["HideHeader"] = true;
    ViewData["HideFooter"] = true;
    ViewData["SpicalHeader"] = true;
    ViewData["SpicalFooter"] = true;
}

<link rel="icon" type="image/png" href="~/images/LamieLogo.png" />

<main class="parent-requests-page" dir="rtl">
    <div class="requests-outer-container">
        <img src="~/images/starLogo.png" class="page-star-logo" alt="star" />
        <h1>طلبات المعلمين</h1>


        <div class="requests-inner-container">
            @if (Model != null && Model.Any())
            {
                @foreach (var req in Model)
                {
                    <div class="request-card">
                        <div class="request-info">
                            <p>المعلم: @req.Educator?.EducatorName</p>
                            <p>الطالب: @req.Child?.ChildName</p>
                            <p>رقم هوية الطالب: @req.ChildId</p>
                            <p>تاريخ الطلب: @req.SentAt?.ToString("yyyy/MM/dd")</p>
                        </div>
                        <div class="request-actions">
                            <form method="post" asp-action="RespondToRequest" asp-controller="Parent">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="requestId" value="@req.RequestId" />
                                <input type="hidden" name="status" value="Approved" />
                                <button type="submit" class="btn-approve">قبول ✓</button>
                            </form>
                            <form method="post" asp-action="RespondToRequest" asp-controller="Parent">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="requestId" value="@req.RequestId" />
                                <input type="hidden" name="status" value="Rejected" />
                                <button type="submit" class="btn-deny">رفض ✗</button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="no-requests">
                    <p>لا توجد طلبات معلقة حالياً</p>
                </div>
            }
        </div>
    </div>
</main>
