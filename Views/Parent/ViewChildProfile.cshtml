@using LamiePlatform.Models.ViewModels
@model ChildProfileViewModel
@{
    ViewData["Title"] = "لامع - الملف الشخصي للطفل";
    ViewData["HideHeader"] = true;
    ViewData["HideFooter"] = true;
    ViewData["SpicalHeader"] = true;
    ViewData["SpicalFooter"] = true;
    var currentParentId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    string avatarPath = Model?.IconImgPath;
    if (string.IsNullOrEmpty(avatarPath))
    {
        avatarPath = (Model?.Gender == "أنثى") ? "~/images/ChildGirl.png" : "~/images/ChildBoy.png";
    }
}
<link rel="icon" type="image/png" href="~/images/LamieLogo.png" />

<div class="child-profile-page">


    @if (Model == null)
    {
        <div class="alert alert-warning">
            لم يتم تحميل بيانات الطفل. الرجاء المحاولة مرة أخرى أو العودة للقائمة.
        </div>
    }
    else
    {
        <div class="child-profile-container">
            <img class="star-logo-corner" src="~/images/starLogo.png" alt="" />
            <h1>الملف الشخصي للطفل</h1>

            <div class="profile-card">
                <div class="profile-avatar">
                    <img src="@Url.Content(avatarPath)" alt="@Model.ChildName" />
                </div>

                <div class="profile-info">
                    <h2>@Model.ChildName</h2>
                    <p class="info-age">@Model.Age سنوات</p>

                    <div class="login-code-box">
                        <span class="login-code-label">كود الدخول للعبة:</span>
                        <span class="login-code-value" id="loginCodeValue">@Model.LoginCode</span>
                        <button type="button" class="btn-copy-code" onclick="copyLoginCode()">نسخ</button>
                    </div>

                    <div class="card-actions">
                        <a asp-action="EditChildProfile" asp-controller="Parent" asp-route-childId="@Model.ChildId" class="btn-action">
                            تعديل المعلومات
                        </a>
                    </div>
                </div>
            </div>

            <div class="school-details" dir="rtl">
                <i class="bi bi-book-fill section-icon"></i>
                <h3>بيانات المدرسة</h3>

                <div class="detail-row">
                    <span class="label">المدينة:</span>
                    <span class="value">@Model.City</span>
                </div>
                <div class="detail-row">
                    <span class="label">المدرسة:</span>
                    <span class="value">@Model.SchoolName</span>
                </div>
                <div class="detail-row">
                    <span class="label">المرحلة:</span>
                    <span class="value">@Model.Grade</span>
                </div>
                <div class="detail-row">
                    <span class="label">الفصل:</span>
                    <span class="value">@Model.Class</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.EducatorName))
                {
                    <div class="detail-row">
                        <span class="label">المعلم:</span>
                        <span class="value">@Model.EducatorName</span>
                    </div>
                }
            </div>

            <div class="contact-section">
                <i class="bi bi-people-fill section-icon"></i>
                <p class="contact-title">إمكانية الوصول لملف الطالب من خلال المشرفين:</p>

                <div class="contact-row">
                    <div class="contact-options">
                        @if (Model.HasPermission)
                        {
                            <form asp-action="RevokeEducatorAccess" asp-controller="Parent" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="childId" value="@Model.ChildId" />
                                <div class="contact-option allow-active">
                                    <input type="checkbox" checked disabled />
                                    <label>سماح</label>
                                </div>
                                <button type="submit" class="action-option deny-btn">منع</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="GrantEducatorAccess" asp-controller="Parent" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="childId" value="@Model.ChildId" />
                                <button type="submit" class="action-option allow-btn">سماح</button>
                                <div class="contact-option deny-active">
                                    <input type="checkbox" checked disabled />
                                    <label>منع</label>
                                </div>
                            </form>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.EducatorId))
                {
                    <div class="contact-chat">
                        <a href="@Url.Action("Chat", "Chat", new { educatorId = Model.EducatorId, parentId = currentParentId })"
                               class="btn-service">
                            💬 مراسلة المعلم
                        </a>
                    </div>
                }
            </div>

            <div class="delete-wrapper">
                <form asp-action="DeleteChildProfile" asp-controller="Parent" method="post"
                      onsubmit="return confirm('هل أنت متأكد من حذف ملف @Model.ChildName؟');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="childId" value="@Model.ChildId" />
                    <button type="submit" class="btn-delete">حذف الملف</button>
                </form>
            </div>

        </div>
    }
</div>

<script>
    function copyLoginCode() {
        var codeEl = document.getElementById('loginCodeValue');
        var code = codeEl ? codeEl.innerText.trim() : '';
        if (!code) return;

        navigator.clipboard.writeText(code).then(function () {
            var btn = document.querySelector('.btn-copy-code');
            if (btn) {
                btn.textContent = 'تم النسخ ✓';
                setTimeout(function () { btn.textContent = 'نسخ'; }, 2000);
            }
        }).catch(function () {
            var textarea = document.createElement('textarea');
            textarea.value = code;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
        });
    }
</script>