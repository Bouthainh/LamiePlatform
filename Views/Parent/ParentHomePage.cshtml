@using BadeePlatform.Models.ViewModels
@model List<ChildrenViewModel>

@{
    ViewData["Title"] = "لامع -صفحة ولي الأمر ";
}
@{
    ViewData["HideHeader"] = true;
    ViewData["HideFooter"] = true;
    ViewData["SpicalHeader"] = true;
    ViewData["SpicalFooter"] = true;
}
<link rel="icon" type="image/png" href="~/images/LamieLogo.png" />

    <main class="parent-home-page">
        <div class="main-container">

            <section class="main-content">
                <div class="page-header">
                    <h1>الصفحة الرئيسية</h1>
                    <div class="logo-corner">
                    <img src="~/images/LamieLogo.png" alt="LamieLogo">
                    </div>
                </div>

                <div class="children-section">
                    <h2>قائمة الأطفال</h2>
                    
                    <div class="children-grid">
                        <div class="add-child-card">

                        <a asp-controller="Parent" asp-action="AddChild">
                                <div class="add-icon">+</div>
                                <p>اضافة طفل</p>
                            </a>
                        </div>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var child in Model)
                        {
                            <div class="child-card">
                                <div class="child-avatar">
                                    <img src="@child.IconImgPath" alt="child icon">
                                </div>
                                <div class="child-info">
                                    <h3>@child.ChildName</h3>
                                    <h3>@child.Age</h3>
                                    <a asp-controller="Parent"
                                       asp-action="ViewChildProfile"
                                       asp-route-childId="@child.ChildId">
                                        عرض الملف
                                    </a>
                                </div>
                            </div>
                        }
                    }
                    else 
                    {
                        <!-- NO Children Message -->
                        <div class="alert alert-warning">
                            ليس لديك أطفال مسجلين... الرجاء إضافة طفل جديد
                        </div>
                    }

                        </div>
                  
                <div class="notifications-section">
                    <h2>الإشعارات</h2>
                    <div class="notifications-list">
                        <div class="notification-item">
                            <div class="notification-icon">🎯</div>
                            <p>تم اكتشاف تقدم في الذكاء البصري لدى عمر</p>
                        </div>
                        <div class="notification-item">
                            <div class="notification-icon">🔔</div>
                            <p>تقرير جديد متاح لطفلك</p>
                        </div>
                        <div id="unreadBadge" style="display:none;" class="notification-item">
                            <div class="notification-icon">💬</div>
                            <a href="@Url.Action("Index", "Chat")">
                                لديك <span id="unreadCount"></span> رسالة غير مقروءة
                            </a>
                        </div>

                    </div>
                </div>
            </section>
        </div>
    </main>
@section Scripts {
    <script>
        function checkUnread() {
            $.getJSON('/Chat/GetUnreadCount', function (data) {
                if (data.count > 0) {
                    $('#unreadCount').text(data.count);
                    $('#unreadBadge').show();
                } else {
                    $('#unreadBadge').hide();
                }
            });
        }

        checkUnread();
        setInterval(checkUnread, 30000);
    </script>
}