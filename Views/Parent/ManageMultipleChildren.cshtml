@using LamiePlatform.Models.ViewModels

@model List<ChildrenViewModel>

@{
    ViewData["Title"] = "لامع - إدارة الأطفال";
}
@{
    ViewData["HideHeader"] = true;
    ViewData["HideFooter"] = true;
    ViewData["SpicalHeader"] = true;
    ViewData["SpicalFooter"] = true;
}
<link rel="icon" type="image/png" href="~/images/LamieLogo.png" />
<div class="manage-children-page">
    <div class="main-container">
        <section class="main-content">
            <img class="star-logo-corner" src="~/images/starLogo.png" alt="" />
            <h2>إدارة الأطفال</h2>


            @if (Model == null || !Model.Any())
            {
                <div class="empty-state">
                    <p>ليس لديك أطفال مسجلين... الرجاء إضافة طفل جديد</p>
                    <a href="@Url.Action("AddChild", "Parent")" class="btn-action">
                        إضافة طفل جديد
                    </a>
                </div>
            }
            else
            {
                <ul class="children-list">
                    @foreach (var child in Model)
                    {
                        <li class="child-card">
                            <div class="child-avatar">
                                <img src="@child.IconImgPath" alt="@child.ChildName">
                            </div>
                            <div class="child-card-content">
                                <h2 class="child-name">@child.ChildName</h2>
                                <div class="child-actions">
                                    <a href="@Url.Action("ViewChildProfile", "Parent", new { childId = child.ChildId })"
                                       class="btn-child-sm">
                                        <i class="bi bi-person-fill"></i> الملف الشخصي
                                    </a>
                                    <a href="@Url.Action("ChildDashboardParent", "Dashboard", new { childId = child.ChildId })"
                                       class="btn-child-sm">
                                        <i class="bi bi-speedometer2"></i> لوحة التحكم
                                    </a>
                                    <a href="@Url.Action("EditChildProfile", "Parent", new { childId = child.ChildId })"
                                       class="btn-child-sm">
                                        <i class="bi bi-pencil-fill"></i> تعديل البيانات
                                    </a>
                                    <form asp-action="DeleteChildProfile" asp-controller="Parent" method="post"
                                          onsubmit="return confirm('هل أنت متأكد من حذف ملف @child.ChildName؟');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="childId" value="@child.ChildId" />
                                        <button type="submit" class="btn-child-sm btn-child-delete">
                                            <i class="bi bi-trash-fill"></i> حذف
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </li>
                    }
                </ul>

                <div class="add-child-footer">
                    <a href="@Url.Action("AddChild", "Parent")" class="btn-action">
                        إضافة طفل
                    </a>
                </div>
            }
        </section>
    </div>
</div>