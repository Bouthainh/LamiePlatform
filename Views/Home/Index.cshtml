@{
    ViewData["ShowSidebar"] = false;
    ViewData["IsHomePage"] = true;
}

@{
    ViewData["Title"] = "لامع - الصفحة الرئيسية ";
}


<section id="main" class="main-section">

    <div class="squiggle-orange"></div>
    <div class="blob-pink"></div>
    <div class="blob-yellow"></div>
    <div class="blob-blue"></div>
    <div class="circle-green"></div>
    <div class="blob-yellow-outline"></div>
    <div class="main-text">

        <img src="~/images/LamieLogo.png" alt="لوقو لامع" class="site-logo">
        
        <p>
            منصّة لامع تساعدك على اكتشاف مواهب طفلك من خلال ألعاب ممتعة
            تعتمد على نظرية قاردنر للذكاءات المتعددة، لتُظهر لك نقاط قوته بطريقة بسيطة
            وذكية
            <br>
            <strong>ابدأ الآن</strong> واكتشف عالم طفلك المميز!
        </p>
        <a asp-controller="Parent" asp-action="Register" class="btn-service">
            سجّل الآن!
        </a>
    </div>

    <div class="main-image">
        <video class="hero-video" src="~/videos/heroscene.mp4"
               autoplay muted loop playsinline
               aria-label="مشهد من اللعبة"></video>
    </div>
</section>

<section id="about" class="about-section">
    <div class="about-star about-star--five"></div>
    <div class="about-star about-star--four"></div>
    <div class="about-star about-star--six"></div>
    <h2>من نحن ؟</h2>
    <p>
                نحن منصّة تعليمية ذكية تُمكّن الآباء والمعلّمين من تطوير ومتابعة
                مواهب الأطفال منذ وقت مبكر، من خلال ألعاب تفاعلية مبنية على نظرية
                الذكاءات المتعددة، لمساعدتهم على فهم قدرات الطفل وتنميتها بشكل مستمر
    </p>
</section>

<section class="features-section">
  <h2>الخدمات</h2>

    <div class="feature-card">
        <img src="~/images/ParentsPic.jpg" alt="منصة الأهل">
        <h3>منصة الأهل</h3>
        <p>تمكّن أولياء الامور من متابعة مواهب طفلهم، رؤية تقدّمه، واستلام توصيات وأنشطة لتنمية ذكائه</p>
        <div class="feature-tags">
            <span>متابعة مستمرة</span>
            <span>تقارير فورية</span>
            <span>توصيات مخصصة</span>
        </div>
    </div>

    <div class="feature-card">
        <img src="~/images/EducatorsPic.jpg" alt="منصة المعلّمين">
        <h3>منصة المعلّمين</h3>
        <p>أدوات لمتابعة مواهب وقدرات الطلاب، إنشاء مجموعات تعليمية، واقتراح أنشطة مبنية على البيانات</p>
        <div class="feature-tags">
            <span>تقييم ذكي</span>
            <span>متابعة مستمرة</span>
            <span>أنشطة مخصصة</span>
        </div>
    </div>

    <div class="feature-card">
        <img src="~/images/LearningPic.jpg" alt="ألعاب تفاعلية">
        <h3>ألعاب تفاعلية</h3>
                            <p>
                                ألعاب تفاعلية ممتعة تقيس ذكاءات الطفل في ثمانية مجالات مختلفة،
                                وتساعد على تطوير نقاط قوته بطريقة طبيعية دون الحاجة إلى اختبار مباشر
                            </p>
        <div class="feature-tags">
            <span>شمولية جميع مجالات الذكاء</span>
            <span>مستويات تدريجية</span>
            <span>تطوير تلقائي</span>
        </div>
    </div>

</section>

<section id="how-it-works" class="process-section">
                        <div class="about-star about-star--five"></div>
                        <div class="about-star about-star--four"></div>
                        <div class="about-star about-star--six"></div>
    <h2>كيف نعمل؟</h2>
    <div class="process-step">
        <div class="step-number">1</div>
        <h3>قياس المهارات</h3>
                                <p>
                                    يبدأ الطفل برحلة ممتعة من خلال ألعاب تفاعلية مصممة لقياس
                                    مختلف جوانب الذكاء، حيث يتم تحليل أدائه بشكل غير مباشر
                                    دون أي شعور بالاختبار
                                </p>
    </div>

    <div class="process-step">
        <div class="step-number">2</div>
        <h3>تحليل النتائج</h3>
                                <p>
                                    تقوم المنصّة بتحليل أداء الطفل تلقائيًا باستخدام تقنيات ذكية،
                                    لتحديد أنماط تفكيره واكتشاف أبرز نقاط قوته، مع إنشاء ملف
                                    شخصي يوضّح مستوى تطوّره في كل مجال
                                </p>
    </div>

    <div class="process-step">
        <div class="step-number">3</div>
        <h3>توصيات مخصصة</h3>
                                <p>
                                    يحصل الأهل والمعلّم على توصيات مخصّصة تتضمن أنشطة وأفكار عملية
                                    تساعد على تنمية مهارات الطفل وتعزيز ذكاءاته بشكل مستمر
                                </p>
    </div>
                        <img src="~/images/Lubnah.png" alt="لبنه _شخصية لعبة">
</section>

<section id="faq" class="faq-section">
    <h2>الأسئلة الشائعة</h2>

                        <div class="faq-items">

                            <div class="faq-item">
                                <div class="faq-question">
                                    <h3>هل المنصّة مجانية؟</h3>
                                    <span class="faq-icon"></span>
                                </div>
                                <div class="faq-answer">
                                    <p>نعم، يوجد نسخة مجانية مع مزايا أساسية.</p>
                                </div>
                            </div>

                            <div class="faq-item">
                                <div class="faq-question">
                                    <h3>هل يحتاج طفلي اللعب كثيرًا؟</h3>
                                    <span class="faq-icon"></span>
                                </div>
                                <div class="faq-answer">
                                    <p>نعم، فكل لعبة مصممة لتنمية مهارة مختلفة.</p>
                                </div>
                            </div>

                            <div class="faq-item">
                                <div class="faq-question">
                                    <h3>متى أستطيع رؤية تقارير الذكاءات؟</h3>
                                    <span class="faq-icon"></span>
                                </div>
                                <div class="faq-answer">
                                    <p>بعد انتهاء الطفل من المرحلة الاستكشافية.</p>
                                </div>
                            </div>

                        </div>
</section>

<section class="cta-section" id="cta">
    <div>
        <h2>كل شخص يولد لامع!</h2>
        <p>امنح طفلك فرصة لمعرفة نقاط قوته بطريقة ممتعة وذكية</p>
        <a asp-controller="Parent" asp-action="Register" class="btn-service"> التسجيل كأهل</a>
        <a asp-controller="Educator" asp-action="Register" class="btn-service">التسجيل كمعلم</a>
    </div>
    <div class="cta-image">
      <img src="~/images/multiIntelegencescene.png" alt="مشهد أطفال بذكاءات متعددة">
    </div>
</section>

 <script>
     document.querySelectorAll(".faq-question").forEach(item => {
     item.addEventListener("click", () => {
            const parent = item.parentElement;

              parent.classList.toggle("open");
            });
           });
   </script>