@model BadeePlatform.DTOs.RegisterEducatorDTO

<h2>تسجيل معلم جديد</h2>

@if (ViewData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@ViewData["ErrorMessage"]</div>
}

<form asp-controller="Educator" asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="EducatorId">رقم الهوية الوطنية</label>
        <input asp-for="EducatorId" type="text" placeholder="أدخل رقم هويتك الوطنية هنا" required maxlength="10" pattern="\d{10}" title="يجب أن يتكون رقم الهوية من 10 أرقام" class="form-control" />
        <span asp-validation-for="EducatorId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="FirstName">الاسم الأول</label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastName">اسم العائلة</label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PhoneNumber">رقم الهاتف</label>
        <input asp-for="PhoneNumber" type="tel" placeholder="05xxxxxxxx" required maxlength="10" pattern="05\d{8}" title="يجب أن يبدأ رقم الجوال بـ 05 ويتكون من 10 أرقام" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="SchoolId">المدرسة</label>
        @Html.DropDownListFor(m => m.SchoolId,
        ViewBag.Schools as SelectList,
                        "-- اختر المدرسة --",
                new { @class = "form-control" })
        <span asp-validation-for="SchoolId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email">البريد الإلكتروني</label>
        <input asp-for="Email" type="email" placeholder="example@email.com" required maxlength="100" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Username">اسم المستخدم</label>
        <input asp-for="Username" type="text" placeholder="أدخل اسم المستخدم هنا" required minlength="3" maxlength="50" class="form-control" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password">كلمة المرور</label>
        <input asp-for="Password" type="password" required minlength="8" maxlength="100" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword">تأكيد كلمة المرور</label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" required minlength="8" maxlength="100" pattern="^(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9])(?=.*[^A-Za-z0-9]).{8,}$"
               title="يجب أن تحتوي كلمة المرور على: حرف كبير، حرف صغير، رقم، ورمز خاص مثل ! @@ # $ % ^ & * ( ) _ - +" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">تسجيل</button>

    <div class="login-link">
        <p>لديك حساب؟ <a asp-controller="Educator" asp-action="Login">سجل الدخول</a></p>
    </div>
</form>