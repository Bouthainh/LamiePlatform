@model BadeePlatform.DTOs.LoginEducatorDTO

<h2>تسجيل دخول المعلم</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (ViewData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@ViewData["ErrorMessage"]</div>
}

<form asp-controller="Educator" asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="UsernameOrEmail">اسم المستخدم أو البريد الإلكتروني</label>
        <input asp-for="UsernameOrEmail" type="text"
               placeholder="أدخل اسم المستخدم أو بريدك هنا"
               required
               minlength="3"
               maxlength="100" class="form-control" />
        <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password">كلمة المرور</label>
        <input asp-for="Password" type="password"
               placeholder="أدخل كلمة المرور هنا"
               required
               minlength="8"
               maxlength="100" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">دخول</button>
</form>
<div class="signup-link">
    <p>
        ليس لديك حساب؟
        <a asp-controller="Educator" asp-action="Register">أنشئ الآن</a>
    </p>
