@model List<LamiePlatform.Models.ChildGroup>
@{
    ViewData["Title"] = "مجموعاتي";
    var classId = ViewBag.ClassId;
    var notGroupedYet = ViewBag.NotGroupedYet ?? false;
    var educatorId = ViewBag.EducatorId as string;
}

<div class="groups-outer" dir="rtl">
    <img src="~/images/starLogo.png" class="groups-star-logo" alt="" />

    <h2 class="groups-heading">مجموعات الفصل</h2>


    @if (notGroupedYet)
    {
        <div class="text-center py-5">
            <h5 class="text-muted mb-4">لم يتم إنشاء مجموعات لهذا الفصل بعد.</h5>
            <form method="post" action="/Grouping/CreateGroups">
                <input type="hidden" name="classId" value="@classId" />
                <button type="submit" class="btn-action">إنشاء المجموعات</button>
            </form>
        </div>
    }
    else
    {
        <div class="row g-4">
            @{
                int groupNumber = 1;
            }
            @foreach (var group in Model)
            {
                <div class="col-md-6">
                    <div class="group-card">
                        <div class="group-card-header">
                            المجموعة @groupNumber
                        </div>
                        <div class="group-card-body">
                            <p class="group-count">الأطفال (@group.Children.Count)</p>
                            <div>
                                @foreach (var child in group.Children)
                                {
                                    var top1 = child.ChildIntelligences
                                        .OrderByDescending(ci => ci.ProficiencyScore)
                                        .FirstOrDefault();
                                    <div class="group-child-item">
                                        <span>@child.ChildName</span>
                                        @if (top1 != null)
                                        {
                                            <span class="child-intel-badge">@top1.Intelligence?.IntelligenceName (@top1.ProficiencyScore)</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="group-btn-wrap">
                                <a asp-controller="Recommendation"
                                   asp-action="EdActivityList"
                                   asp-route-educatorId="@educatorId"
                                   asp-route-groupId="@group.ChildGroupId"
                                   class="group-rec-btn">
                                    عرض التوصيات
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                groupNumber++;
            }
        </div>
    }
</div>
