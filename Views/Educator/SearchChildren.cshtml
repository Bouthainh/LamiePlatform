@model List<LamiePlatform.Models.Child>
@{
    ViewData["Title"] = "لامع - البحث عن طفل";
    ViewData["HideHeader"] = true;
    ViewData["HideFooter"] = true;
    ViewData["SpicalHeader"] = true;
    ViewData["SpicalFooter"] = true;
}

<link rel="icon" type="image/png" href="~/images/LamieLogo.png" />

<div class="search-outer" dir="rtl">
    <img src="~/images/starLogo.png" class="search-star-logo" alt="" />

    <h1 class="search-heading">البحث عن طفل وإرسال طلب</h1>


    <form method="get" asp-action="SearchChildren" asp-controller="Educator">
        <div class="search-bar-wrap">
            <div class="search-bar-inner">
                <i class="bi bi-search search-icon"></i>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm"
                       placeholder="أدخل الاسم أو رقم الهوية" />
                <button type="submit" class="btn-search">بحث</button>
            </div>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <h2 class="search-results-heading">نتائج البحث</h2>
        <div class="search-table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>رقم الهوية</th>
                        <th>اسم الطفل</th>
                        <th>المرحلة</th>
                        <th>الفصل</th>
                        <th>إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var child in Model)
                    {
                        <tr>
                            <td>@child.ChildId</td>
                            <td>@child.ChildName</td>
                            <td>@child.Grade?.GradeName</td>
                            <td>@child.Class?.ClassName</td>
                            <td>
                                <form method="post" asp-action="SendRequest" asp-controller="Educator">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="childId" value="@child.ChildId" />
                                    <button type="submit" class="btn-send-request">إرسال طلب</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (ViewBag.SearchTerm != null)
    {
        <p class="search-no-results">لا توجد نتائج مطابقة في مدرستك</p>
    }

    @if (ViewBag.SentRequests != null)
    {
        var sentRequests = ViewBag.SentRequests as List<LamiePlatform.Models.Request>;
        if (sentRequests != null && sentRequests.Any())
        {
            <h2 class="search-results-heading">الطلبات المرسلة</h2>
            <div class="search-table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>اسم الطفل</th>
                            <th>تاريخ الإرسال</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in sentRequests)
                        {
                            <tr>
                                <td>@req.Child?.ChildName</td>
                                <td>@req.SentAt?.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (req.RequestStatus == "Pending") { <span>قيد الانتظار</span> }
                                    else if (req.RequestStatus == "Approved") { <span>مقبول</span> }
                                    else if (req.RequestStatus == "Rejected") { <span>مرفوض</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
