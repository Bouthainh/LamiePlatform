@using System.Text.RegularExpressions
@model List<LamiePlatform.Models.Message>
@{
    var userType       = ViewBag.UserType as string;
    var userId         = ViewBag.UserId as string;
    var conversationId = ViewBag.ConversationId;
    var educatorId     = ViewBag.EducatorId as string;
    var parentId       = ViewBag.ParentId as string;

    string RenderContent(string raw)
    {
        if (string.IsNullOrEmpty(raw)) return "";
        var escaped = System.Net.WebUtility.HtmlEncode(raw);
        escaped = Regex.Replace(
            escaped,
            @"(https?://[^\s]+)",
            "<a href=\"$1\" target=\"_blank\" style=\"color:inherit;text-decoration:underline\">$1</a>");
        escaped = escaped.Replace("&#xA;", "<br>").Replace("\n", "<br>");
        return escaped;
    }
}

<div class="chat-page-wrap">
    <div class="chat-frame">

        <div class="chat-header">
            <a href="@Url.Action("Index", "Chat")" class="btn-back-chat">رجوع</a>
            <h5 class="chat-header-title">المحادثة</h5>
        </div>

        <div class="chat-messages" id="chatBox">
            @foreach (var msg in Model)
            {
                var isMine = msg.SenderId == userId;
                <div class="chat-bubble-wrap @(isMine ? "mine" : "theirs")">
                    <div class="chat-bubble @(isMine ? "mine" : "theirs")">
                        @Html.Raw(RenderContent(msg.Content))
                        <small class="bubble-time">
                            @msg.SentAt?.ToString("hh:mm tt")
                            @if (isMine) { <span>@(msg.IsRead ? "✓✓" : "✓")</span> }
                        </small>
                    </div>
                </div>
            }
        </div>

        <div class="chat-footer">
            <form asp-action="SendMessage" asp-controller="Chat" method="post">
                <input type="hidden" name="conversationId" value="@conversationId" />
                <input type="hidden" name="educatorId"     value="@educatorId" />
                <input type="hidden" name="parentId"       value="@parentId" />
                <input type="text" name="content" class="chat-input"
                       placeholder="اكتب رسالتك هنا..." required autocomplete="off" />
                <button type="submit" class="btn-send">إرسال</button>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        var chatBox = document.getElementById('chatBox');
        chatBox.scrollTop = chatBox.scrollHeight;
    </script>
}
