@model LamiePlatform.Models.ViewModels.RecommendationViewModel

@{
    ViewData["Title"] = "التوصيات";
}

<div class="alert alert-info d-flex align-items-start gap-3 mb-4" role="alert">
    <div>
        <h5 class="alert-heading mb-1">ميزة مدعومة بالذكاء الاصطناعي</h5>
        <p class="mb-0">
            تعتمد هذه الصفحة على الذكاء الاصطناعي لتحليل نقاط قوة طفلك وفق نظرية الذكاءات المتعددة،
            ثم اقتراح أنشطة منزلية مناسبة تُنمّي مهاراته وتدعم تطوره بأسلوب ممتع وسهل التطبيق في البيت.
            يمكنك توليد توصية جديدة في أي وقت، وستُحفظ جميع التوصيات السابقة في القائمة أدناه
        </p>
    </div>
</div>

<h2>التوصيات النشاطية</h2>

@if (TempData["Success"] != null)
{
    <p style="color:green;">@TempData["Success"]</p>
}
@if (TempData["Error"] != null)
{
    <p style="color:red;">@TempData["Error"]</p>
}

@if (!Model.Recommendations.Any())
{
    <p>لا توجد توصيات بعد... اضغط على الزر أدناه لتوليد أول توصية</p>
}
else
{
    <table border="1" cellpadding="8" cellspacing="0">
        <thead>
            <tr>
                <th>اسم النشاط</th>
                <th>الفئة</th>
                <th>التفاصيل</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Recommendations)
            {
                <tr>
                    <td>@item.ActivityName</td>
                    <td>@item.Category</td>
                    <td>
                        <a asp-action="ActivityDetail" asp-route-id="@item.RecommendationId">عرض</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<br />

<form asp-action="GenerateForChild" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="childId" value="@Model.ChildId" />
    <button type="submit">توليد توصية جديدة</button>
</form>
