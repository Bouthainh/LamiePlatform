@model LamiePlatform.Models.ViewModels.RecommendationViewModel

@{
    ViewData["Title"] = "التوصيات";
}

<div class="rec-outer" dir="rtl">
    <img src="~/images/starLogo.png" class="rec-star-logo" alt="" />

    <h2 class="rec-heading">التوصيات النشاطية</h2>


    <div class="rec-inner">
        @if (!Model.Recommendations.Any())
        {
            <div class="rec-empty">
                <p>لا توجد توصيات بعد... اضغط على الزر أدناه لتوليد أول توصية</p>
            </div>
        }
        else
        {
            <div class="rec-table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>اسم النشاط</th>
                            <th>الفئة</th>
                            <th>التفاصيل</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Recommendations)
                        {
                            <tr>
                                <td>@item.ActivityName</td>
                                <td>@item.Category</td>
                                <td>
                                    <a asp-action="ActivityDetail" asp-route-id="@item.RecommendationId" class="rec-view-btn">عرض</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="text-center mt-3">
            <form asp-action="GenerateForChild" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="childId" value="@Model.ChildId" />
                <button type="submit" class="btn-action">توليد توصية جديدة</button>
            </form>
        </div>
    </div>

    <div class="rec-ai-box">
        <span class="rec-ai-icon"><i class="bi bi-robot"></i></span>
        <p class="rec-ai-heading">ميزة مدعومة بالذكاء الاصطناعي</p>
        <p class="rec-ai-text">
            تعتمد هذه الصفحة على الذكاء الاصطناعي لتحليل نقاط قوة طفلك وفق نظرية الذكاءات المتعددة،
            ثم اقتراح أنشطة منزلية مناسبة تُنمّي مهاراته وتدعم تطوره بأسلوب ممتع وسهل التطبيق في البيت.
            يمكنك توليد توصية جديدة في أي وقت، وستُحفظ جميع التوصيات السابقة في القائمة أدناه.
        </p>
    </div>
</div>
