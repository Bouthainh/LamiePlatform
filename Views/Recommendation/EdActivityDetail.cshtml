@model LamiePlatform.Models.ViewModels.RecommendationDetailViewModel

@{
    ViewData["Title"] = "تفاصيل التوصية";
}

<div class="rec-outer" dir="rtl">
    <img src="~/images/starLogo.png" class="rec-star-logo" alt="" />

    <h2 class="rec-heading-secondary">تفاصيل التوصية</h2>

    <div class="rec-inner">
        <div class="rec-table-detail">
            <table>
                <tbody>
                    <tr>
                        <th>اسم النشاط</th>
                        <td>@Model.ActivityName</td>
                    </tr>
                    <tr>
                        <th>الوصف</th>
                        <td>@Model.ActivityDescription</td>
                    </tr>
                    <tr>
                        <th>المدة (دقيقة)</th>
                        <td>@(Model.Duration.HasValue ? Model.Duration.Value.ToString() + " دقيقة" : "غير محدد")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="mt-3 text-end">
            <a asp-action="EdActivityList"
               asp-route-educatorId="@ViewBag.EducatorId"
               asp-route-groupId="@Model.GroupId"
               class="btn-back">
                العودة إلى قائمة التوصيات
            </a>
        </div>
    </div>
</div>
