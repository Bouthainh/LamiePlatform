@model LamiePlatform.Models.ViewModels.EducatorRecommendationViewModel

@{
    ViewData["Title"] = "توصيات المعلم";
}

<h2>التوصيات النشاطية للمجموعة</h2>

@if (TempData["Success"] != null)
{
    <p style="color:green;">@TempData["Success"]</p>
}
@if (TempData["Error"] != null)
{
    <p style="color:red;">@TempData["Error"]</p>
}

@if (!Model.Recommendations.Any())
{
    <p>لا توجد توصيات بعد. اضغط على الزر أدناه لتوليد أول توصية.</p>
}
else
{
    <table border="1" cellpadding="8" cellspacing="0">
        <thead>
            <tr>
                <th>اسم النشاط</th>
                <th>الفئة</th>
                <th>التفاصيل</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Recommendations)
            {
                <tr>
                    <td>@item.ActivityName</td>
                    <td>@item.Category</td>
                    <td>
                        <a asp-action="GroupDetail" asp-route-id="@item.RecommendationId">عرض</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<br />

@if (Model.GroupId.HasValue)
{
    <form asp-action="GenerateForGroup" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="groupId" value="@Model.GroupId" />
        <input type="hidden" name="educatorId" value="@Model.EducatorId" />
        <button type="submit">توليد توصية جديدة للمجموعة</button>
    </form>
}
else
{
    <p>لا توجد مجموعة محددة. يرجى الوصول من صفحة المجموعة.</p>
}
